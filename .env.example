PDM_URL=https://pdm.example.com:8443
PDM_TOKEN_ID=readonly@pdm!mcp
PDM_TOKEN_SECRET=replace-with-token-secret
MCP_AUTH_MODE=disabled
# For scoped authentication, set MCP_AUTH_MODE=jwt and supply a server-side secret
# containing at least 32 random bytes. Never expose it to browsers or LLMs.
# MCP_JWT_SECRET=<server-side-random-signing-secret>
MCP_JWT_AUDIENCE=pdm-mcp
# Only for a lab with an internal/self-signed certificate:
# PDM_TLS_INSECURE=true
